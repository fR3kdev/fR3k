# Reference configuration only: the scripts do not automatically load this file.
# Export the variables needed by the command you run. Never commit real tokens.
# Full runtime guide: agentic-action-engine/README.md

# Dependency-free Python router: no provider key or benchmark runner is required.
ROUTER_TRIVIAL_MAX_TOKENS=40
ROUTER_COMPLEX_MIN_SCORE=0.45

# Three-app runtime (npm run demo:live).
# Token resolution: FR3K_GITHUB_TOKEN, then GH_TOKEN, then `gh auth token`.
# FR3K_GITHUB_TOKEN=
# FR3K_REPOSITORY=fR3kdev/fR3k
# FR3K_ISSUE_NUMBER=1
# FR3K_YOUTUBE_VIDEO_ID=xKOL36Yjs0U
# The video must currently be live for the evaluator to pass.
# FR3K_NTFY_TOPIC=your-isolated-topic
# Omit the topic to generate a fresh random topic for each launch.
# FR3K_OPERATOR=stream-operator
# FR3K_TRACE_ROOT=.work/live-traces
# Leave FR3K_APPROVE unset for interactive approval of each exact write.
# FR3K_APPROVE=1 grants all pending approvals without prompting.

# Read-only GitHub attach (npm run demo-live).
# Token resolution: GH_TOKEN, then GITHUB_TOKEN, then `gh auth token`.
# LIVE_GH_OWNER=fR3kdev
# LIVE_GH_REPO=fR3k

# The shipped demos use deterministic planners. Provider API keys alone do not
# enable model-backed execution; a host must wire the bounded model provider.
