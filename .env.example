# Provider keys — all optional. Fallback chain (in order):
#   1. OPENROUTER_API_KEY  → unified gateway, recommended (covers all models)
#   2. ANTHROPIC_API_KEY   → used for claude-* model IDs
#   3. OPENAI_API_KEY      → used for gpt-* model IDs
#
# If no key is set, bench.py runs in SIMULATED mode (estimates tokens via
# tiktoken, applies pricing.py rates, generates plausible scores). This is
# the mode used to produce the README results table — see "Reproducing These
# Numbers" in the README.

OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override base URL (e.g. point to a local vLLM / LM Studio server)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Router thresholds (override defaults in router.py)
ROUTER_TRIVIAL_MAX_TOKENS=40
ROUTER_COMPLEX_MIN_SCORE=0.45
